<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Coarse only: the weather is per city, and a finer fix would name nothing more. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Confirming the device credential before showing an account's name and
         organisation. Not a hardware requirement: a phone with no lock screen skips the
         prompt entirely, so this must never gate installation. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Pocket mode's way out: a wake-up sensor's event, with both screens off, holds the
         processor awake only until the listener returns, and switching the back on is a
         binder call and an exec after that. See PocketWatch. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- "Follows the music" (service/MusicLevel), off until he switches it on: Android's only measure of the sound
         being played (audiofx.Visualizer on the output mix) is refused without these. Nothing is recorded or kept. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- so the app may ask whether HyperOS's rear-screen app is installed (Setup.kt) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <queries>
        <package android:name="dev.chicken.circlesearch" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.xiaomi.subscreencenter" />
        <!-- The health check (service/Health.WATCHED): their versions, and Shizuku's page for its button. -->
        <package android:name="com.android.incallui" />
        <package android:name="com.android.deskclock" />
        <package android:name="com.android.camera" />
        <package android:name="com.miui.home" />
        <package android:name="moe.shizuku.privileged.api" />
        <!-- OpenAI's Dots characters, read from the ChatGPT app where they lie (rear/dots/DotsSource). -->
        <package android:name="com.openai.chatgpt" />
        <!-- App Portal: the apps a person can pin, and their icons on the back. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
        <!-- Notes with a place (PlaceNotes): asked for only when the first such note is made. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Pin to location: whether there is a connection (no search while offline, the GPS try on waking without one). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Earbuds connecting (service/EarbudsWatch, ui/EarbudsOverlay): the ripple over other apps (his to allow), the
         battery level the earbuds report for the back (Nearby devices, his to allow). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
<application
        android:name=".App"
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!--
          HyperOS asks, before it lets an activity start on the rear display, whether the
          app declares itself a rear-display app: meta-data miui.rear.policy, 1 for
          allowed, 0 for not, unset otherwise — ActivityStarterImpl.isShouldShowOnRearDisplay
          in miui-services, which logs "allow app" / "should not allow app". Without it,
          every start of the panel aimed at the rear display is aborted, and the panel
          could only ever be started on the front screen and moved across afterwards —
          which is what a panel "respawning on the front screen" looks like when the
          system relaunches it. Declared for the app and again on the panel's activity.
        -->
        <meta-data android:name="miui.rear.policy" android:value="1" />
        <!--
          Shizuku's own list of apps (its "Authorized N applications" card) shows only apps
          that declare this, so without it Magic Rear held the permission but never appeared
          there and couldn't be switched off from Shizuku (AuthorizationManager.getPackages,
          Shizuku 13.6.0). The permission itself works either way.
        -->
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
        <!-- SettingsTheme follows the phone's light or dark mode (values / values-night). -->
        <!-- A note's place reached or left (place/Fences): Play services' word, to this app alone. -->
        <receiver android:name=".place.FenceReceiver" android:exported="false" />
        <!--
          "Pin to back": text shared here, or picked in a text-selection menu, becomes a note on the
          back's notes page. exported: other apps start it (Circle Search's "Pin to back", any share sheet).
        -->
        <activity
            android:name=".ui.PinActivity"
            android:exported="true"
            android:label="Pin to back"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!--
              Read by Circle Search as it pins: this app CAN play the pin above an overlay (so Circle Search may stay
              open under it). It DOES so only while "Pin to back: glass" (service/PinGlassService) is switched on in
              the phone's Accessibility settings: without it the animation is in this activity's window, under such
              an overlay. A caller that stays open must look at both.
            -->
            <meta-data android:name="dev.chicken.pin.DRAWS_OVER_OVERLAYS" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- A picture pinned (ui/PinShare): one, or several (one note each, the first three). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!--
          "Pin to location" (ui/place): from the same text-selection menu and share sheet, a little prompt with his quick
          tiles and a map (MapLibre on OpenFreeMap: no key); the note waits, and stands on the back when he reaches the
          place. It ends the way a plain pin does, through .ui.PinActivity.
        -->
        <activity
            android:name=".ui.place.PlacePinActivity"
            android:exported="true"
            android:label="Pin to location"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- A picture for a place: one (a note for a place is one note). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!--
          A pinned picture, opened on the front by a tap on it on the back (ui/PinViewActivity). Started by the back's
          shell (`am start`, rear/PictureTap.command), which reaches only an exported screen; and so ONLY A HOLDER OF DUMP
          may start it: adb's shell (our Shizuku processes) has it, an app cannot get it but from adb. It takes one number
          (a note's time) and shows that note's own picture: nothing else of the intent is read. Its own task, not in
          Recents, gone when closed or left; never over the lock screen (it asks for the unlock first).
          screenOrientation="user" is LOAD-BEARING: the window is translucent, and a translucent screen that asks for no
          orientation is passed over, so the screen under it (the launcher, held upright) would keep a turned phone's
          picture upright and small. "user" turns with the phone as the phone's own settings allow, as a photo does.
        -->
        <activity
            android:name=".ui.PinViewActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.pinview"
            android:showWhenLocked="false"
            android:enableOnBackInvokedCallback="true"
            android:screenOrientation="user"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/PinViewTheme" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/SettingsTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The way back from the browser after a sign-in (auth/SignInPage's one button). A browser in front cannot
          be left by the app itself (Android refuses an activity start from the background), so the page that
          says "Signed in" links to this address and his tap opens it. It reads nothing from the link and only
          brings the settings forward: no page on the web can make this app do anything else through it.
          The scheme is this build's own package name, so a debug and a release build each get their own.
        -->
        <activity
            android:name=".ui.SignInReturnActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="signin" />
            </intent-filter>
        </activity>

        <!--
          Our camera page on the back (ui/camera/RearCameraActivity), started by the back's shell on the stroke from the
          left (rear/RearCameraRoute): `am start` reaches only an exported screen, so ONLY A HOLDER OF DUMP may start it
          (adb's shell, our Shizuku processes). It reads nothing of its intent, never asks for a permission (the settings'
          Camera section does), and closes at once on the front screen or without the camera permission. Its own process
          and task, not in Recents, never over the lock screen. miui.rear.policy lets HyperOS start it on the back, as
          RearActivity. Opaque and black (RearCameraTheme).
        -->
        <activity
            android:name=".ui.camera.RearCameraActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":camera"
            android:taskAffinity="${applicationId}.rearcamera"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="nosensor"
            android:configChanges="density|screenSize|smallestScreenSize|screenLayout|orientation|uiMode|keyboardHidden"
            android:theme="@style/RearCameraTheme">
            <meta-data android:name="miui.rear.policy" android:value="1" />
        </activity>

        <!-- Rear panel window. exported=true because HyperOS denies shell
             START_ANY_ACTIVITY against non-exported targets. No intent filters —
             explicit component only. configChanges so the move to display 1 does not
             recreate it.

             android:process=":rear" is LOAD-BEARING and was restored after being
             removed. The theory for removing it was that the default process gets the
             foreground service's importance and would therefore be protected; in
             practice it made things worse. Sharing a process with MainActivity means
             the panel is stopped alongside it when the app is backgrounded, and the
             rear panel went dark the moment the app lost focus. Isolated, the panel
             activity keeps its own lifecycle and survives the app being backgrounded.
             Do not merge these processes again without testing a background soak. -->
        <activity
            android:name=".rear.RearActivity"
            android:exported="true"
            android:process=":rear"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.rear"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="density|screenSize|smallestScreenSize|screenLayout|orientation|uiMode"
            android:theme="@style/RearTheme">
            <meta-data android:name="miui.rear.policy" android:value="1" />
        </activity>

        <!--
          Mirrors other apps' notifications to the rear panel. Binding requires the
          system permission below AND the user granting notification access by hand in
          Settings; neither can be done from code, which is the whole cost of this
          feature. exported must be true: the SYSTEM binds this, not us.
        -->
        <service
            android:name=".service.NotificationRelay"
            android:exported="true"
            android:label="${appLabel} panel"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          OpenAI's Dots character for ChatGPT's vessel on the usage page (rear/dots/DotsService): the ChatGPT app's
          own renderer, loaded from that app's APK, in a process of its own, since a crash in its native code cannot
          be caught. Bound only by this app (DotsLink), and only while "ChatGPT's character" is switched on (off by
          default) and ChatGPT is signed in.
        -->
        <service
            android:name=".rear.dots.DotsService"
            android:exported="false"
            android:process=":dots" />

        <activity
            android:name=".circle.AnchorActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".service.PinGlassService"
            android:exported="true"
            android:label="@string/pin_glass_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/pin_glass" />
        </service>

        <!-- Send to back: the Quick Settings tile that moves the front app to the rear. -->
        <service
            android:name=".service.PortalTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_send_to_back"
            android:label="Send to back"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".service.UsagePollService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!--
              specialUse, NOT dataSync, and this is the difference between a panel that
              lasts and one that dies every afternoon.

              Since Android 15 a dataSync foreground service is capped at SIX HOURS in
              any 24, after which the system stops it. This app targets 36. That cap
              describes a sync job perfectly and describes this service not at all: it
              is not moving data on a schedule, it is holding a second display alive for
              as long as the phone is on. When it is stopped the panel goes with it, and
              nothing on the device says why.

              specialUse is the category for exactly this — a foreground service whose
              purpose none of the standard types fit — and it carries no time limit. It
              costs a declared reason, below, which is the honest trade.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuously drives an always-on secondary display panel and polls usage limits for it" />
        </service>

        <!-- Restarts UsagePollService after a device reboot — see BootReceiver's
             KDoc for why this alone does not mean the panel reappears immediately
             (Shizuku itself needs a manual restart on this device). directBootAware
             left at its default "false": placement needs TokenStore's Keystore
             access, which needs user-unlocked (credential-encrypted) storage
             anyway, so there is nothing useful this receiver could do before then. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Remote control's two doors (see RemoteReceiver, RemoteActivity). Exported, since they
          are for other apps — Home Assistant, Tasker, MacroDroid — and DISABLED until the
          user switches remote control on (RemoteStore.enabled), so a phone that never uses
          it has nothing exported here at all. What comes through is let in by a token, not
          by being able to reach these.
        -->
        <receiver
            android:name=".remote.RemoteReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.chicken.rear.COMMAND" />
            </intent-filter>
        </receiver>
        <!-- VIEW + DEFAULT only: not BROWSABLE, so no web page can open one of these links. -->
        <activity
            android:name=".remote.RemoteActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="chickenrear" />
            </intent-filter>
        </activity>

        <!--
          The pinned pictures (data/PinImageFiles, the external files folder's pins/), each handed to Xiaomi's own pin as
          a content address of ours, that one address readable by its package alone. Not exported: nothing reads it
          without a grant.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pins"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/pin_files" />
        </provider>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery" tools:node="remove" />
        <service android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService" tools:node="remove" />
        <receiver android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver" tools:node="remove" />
    </application>
</manifest>
