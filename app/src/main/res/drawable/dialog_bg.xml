<?xml version="1.0" encoding="utf-8"?>
<!--
  A dialog's window. Square, because everything else in this app is: the panel is
  axis-aligned pixel art and the settings list is flat rows, so a rounded card floating
  over them reads as a piece of a different application.

  Colours from colors_settings.xml, light or (values-night) dark.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/settings_dialog" />
    <stroke android:width="1dp" android:color="@color/settings_dialog_rule" />
</shape>
