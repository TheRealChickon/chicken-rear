# Android / Gradle
*.iml
.gradle/
.kotlin/
local.properties
build/
captures/
.externalNativeBuild/
.cxx/
# Anchored on purpose: a bare `release/` would also swallow app/src/release/, a source set.
/app/release/

# Signing material. Never commit these: a release key cannot be rotated.
*.jks
*.keystore
*.p12
*.pem
keystore.properties
/keys/

# Credentials
*.token.json
credentials.json
.env
.env.*

# Built packages: they belong on a release, not in the tree
*.apk
*.aab
*.idsig

# Video clips and footage: none is published (see the README, "What is not included")
*.mp4
*.mkv
*.webm
*.mov
/clips/

# Files pulled from a phone or from Xiaomi's packages: never published
*.pag
*.glb
*.spv
*.mrc

# Local notes, task folders, captures and tools that stay on the developer's machine
CLAUDE.md
AGENTS.md
.claude/
/tasks/
/outputs/
/logs/
/docs/
/tools/
*.log

# IDE and OS
.idea/
*.hprof
.DS_Store
Thumbs.db

# Isolated worktrees
.worktrees/
